# Copy to .env and fill in.  Never commit the real .env.
DJANGO_SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=liqui-moly.com.tm,www.liqui-moly.com.tm
# CSRF_TRUSTED_ORIGINS defaults to https://<each ALLOWED_HOSTS entry>

# PostgreSQL (leave POSTGRES_DB empty to use SQLite locally)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional
# CACHE_URL=redis://127.0.0.1:6379/1   # default: file cache in ./cache
# CACHE_DIR=/home/ubuntu/liqui_moly/liquimoly/cache
# LOGIN_RATE_LIMIT_ATTEMPTS=10
# LOGIN_RATE_LIMIT_WINDOW=900
